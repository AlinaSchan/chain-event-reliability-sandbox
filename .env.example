# Copy to .env for local runs. Every value below is a placeholder that matches docker-compose.yml.
# This project contains no real credentials, keys or RPC endpoints, and none should be added here.

# --- Dependencies ---------------------------------------------------------------
DATABASE_URL=postgres://sandbox:sandbox@127.0.0.1:5432/cers
DB_SCHEMA=public
# Leave REDIS_URL empty to run without the notification pipeline (events and checkpoints still work).
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=cers

# --- Fixture chain (deterministic, synthetic) -----------------------------------
CHAIN_ID=31337
FIXTURE_SEED=cers-demo
# Blocks mined before the service starts scanning, so there is something to ingest immediately.
FIXTURE_INITIAL_BLOCKS=30
# Mine one fixture block every N ms while the service runs. 0 = only on demand.
FIXTURE_AUTOMINE_MS=0
# Optional JSON file of watched contracts and thresholds (see docs/architecture.md). Unset = built-in synthetic list.
WATCHLIST_FILE=
# Stable name of this process's stream consumer; a restart with the same name sees its own unacknowledged messages first.
CONSUMER_NAME=consumer-1

# --- Scanner policy ---------------------------------------------------------------
START_BLOCK=0
BATCH_SIZE=20
# Blocks that must sit on top of an event's block before it is treated as confirmed.
CONFIRMATION_DEPTH=12
# Deepest reorganization the scanner will roll back automatically. Deeper = halt and report.
MAX_REORG_DEPTH=64
# Safety-net poll; notifications are only a hint that the head may have moved.
POLL_INTERVAL_MS=5000

# --- Local API --------------------------------------------------------------------
API_HOST=127.0.0.1
API_PORT=3000
# Admin and fault-injection routes. Refused unless the API is bound to loopback and a token is set.
ADMIN_ENABLED=false
ADMIN_TOKEN=
LOG_LEVEL=info
